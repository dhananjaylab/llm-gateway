# Copy to .env and fill in. Phase 1 reads these directly from the process
# environment (app/core/config.py) — no secrets manager integration yet.
# Provider adapters only get instantiated for providers whose key is set
# (see app/providers/registry.py), except Ollama, which is always
# registered since a local install needs no key.

# --- Provider credentials (never sent to or accepted from clients) --------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Local Ollama needs no key. For Ollama Cloud, set both:
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=

# --- Gateway config ---------------------------------------------------------
# Path to the per-team YAML config (see config/teams.yaml).
CONFIG_PATH=config/teams.yaml

# --- Not yet used in Phase 1 (reserved; wired in the phase noted) ----------
# REDIS_URL=                        # Phase 2
# GATEWAY_ADMIN_KEY=                # Phase 2
# OTEL_EXPORTER_OTLP_ENDPOINT=      # Phase 4
# OTEL_SEMCONV_STABILITY_OPT_IN=    # Phase 4
# SLACK_WEBHOOK_URL=                # Phase 4
