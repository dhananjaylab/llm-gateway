# Copy to .env and fill in. Provider adapters only get instantiated for
# providers whose key is set (see app/providers/registry.py), except
# Ollama, which is always registered since a local install needs no key.

# --- Provider credentials (never sent to or accepted from clients) --------
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Local Ollama needs no key. For Ollama Cloud, set both:
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=

# --- Gateway config ---------------------------------------------------------
# config/teams.yaml is now only the bootstrap SEED for Redis (Phase 2) —
# see README "Config hot-reload". Edits after first boot need either a
# fresh Redis or the Admin API.
CONFIG_PATH=config/teams.yaml
PRICING_PATH=config/pricing.yaml

# --- Phase 2: Redis + Admin API ---------------------------------------------
REDIS_URL=redis://localhost:6379/0

# Elevated secret for every /admin/* route (X-Gateway-Admin-Key header).
# Distinct from any team key. Generate one with e.g. `openssl rand -hex 32`.
GATEWAY_ADMIN_KEY=

# Resolves the TRD Appendix A "Redis failure mode" open decision for the
# RATE-LIMIT axis only (budget enforcement is always fail-closed, not a
# toggle — see app/ratelimit/budget.py). true = fall back to a local,
# non-distributed limiter and keep serving traffic; false = reject with
# 503 whenever Redis is unreachable.
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_KEY_TTL_SECONDS=7200

# Soft-warning threshold as a fraction of a team's budget cap (TRD: 80%).
BUDGET_WARN_FRACTION=0.8

# Batch-priority queueing (see app/ratelimit/priority_queue.py).
BATCH_QUEUE_MAX_WAIT_SECONDS=2.0
BATCH_QUEUE_POLL_INTERVAL_SECONDS=0.1
BATCH_QUEUE_MAX_LENGTH=200

# --- Not yet used in Phase 2 (reserved; wired in the phase noted) ----------
# OTEL_EXPORTER_OTLP_ENDPOINT=      # Phase 4
# OTEL_SEMCONV_STABILITY_OPT_IN=    # Phase 4
# SLACK_WEBHOOK_URL=                # Phase 4
