{
  "id": null,
  "uid": "llm-gateway-performance",
  "title": "LLM Gateway - Performance",
  "tags": [
    "llm-gateway",
    "performance"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "style": "dark",
  "editable": true,
  "panels": [
    {
      "id": null,
      "title": "Latency Percentile Bands (P50 / P95 / P99)",
      "description": "End-to-end request latency (Document 05's own definition of this metric) -- includes upstream provider round-trip time, not isolated gateway-proxy-only overhead. The <10ms gateway-overhead SLA itself is Phase 5's k6 load-test benchmark (direct-upstream vs. through-gateway), not a continuously exported metric.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(gen_ai_server_request_duration_seconds_bucket[5m])))",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gen_ai_server_request_duration_seconds_bucket[5m])))",
          "legendFormat": "P95",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(gen_ai_server_request_duration_seconds_bucket[5m])))",
          "legendFormat": "P99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        }
      }
    },
    {
      "id": null,
      "title": "Time to First Token (streaming)",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le, provider) (rate(gen_ai_server_time_to_first_token_seconds_bucket[5m])))",
          "legendFormat": "P50 {{provider}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(gen_ai_server_time_to_first_token_seconds_bucket[5m])))",
          "legendFormat": "P95 {{provider}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        }
      }
    },
    {
      "id": null,
      "title": "Token Throughput (tokens/sec) by Type",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (type) (rate(gen_ai_token_usage_total[5m]))",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        }
      }
    },
    {
      "id": null,
      "title": "Cache Hit Rate by Layer (Phase 9b)",
      "description": "This is the panel the original UI/UX brief's Performance-dashboard description already anticipated ('...and if applicable cache hit rates') before any caching feature existed to populate it. exact_hit and semantic_hit are each a fraction of ALL cache-eligible lookups (exact_hit + semantic_hit + miss), not of total gateway traffic -- ineligible (streaming/tool-calling/high-temperature/opted-out) requests never reach this denominator at all. See docs/PHASE9B_KICKOFF_SCOPING.md Sec 8.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (layer) (rate(gen_ai_cache_requests_total{layer=~\"exact_hit|semantic_hit|miss\"}[5m])) / ignoring(layer) group_left sum(rate(gen_ai_cache_requests_total{layer=~\"exact_hit|semantic_hit|miss\"}[5m]))",
          "legendFormat": "{{layer}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "mean"
          ]
        }
      }
    },
    {
      "id": null,
      "title": "Cache Savings (USD) by Team (Phase 9b)",
      "description": "Cumulative gen_ai_cache_savings_usd_total -- the cost the cached entry originally incurred, credited on every hit. Direct input to the per-model cost-tier panels on the Business dashboard.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (team_id) (gen_ai_cache_savings_usd_total)",
          "legendFormat": "{{team_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        }
      }
    }
  ]
}
