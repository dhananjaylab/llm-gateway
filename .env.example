# Copy to .env and fill in. Provider adapters only get instantiated for
# providers whose key is set (see app/providers/registry.py), except
# Ollama, which is always registered since a local install needs no key.

# --- Provider credentials (never sent to or accepted from clients) --------
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Local Ollama needs no key. For Ollama Cloud, set both:
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=

# --- Gateway config ---------------------------------------------------------
# config/teams.yaml is now only the bootstrap SEED for Redis (Phase 2) —
# see README "Config hot-reload". Edits after first boot need either a
# fresh Redis or the Admin API.
CONFIG_PATH=config/teams.yaml
PRICING_PATH=config/pricing.yaml
# Phase 3: tier name -> ordered fallback-chain mapping. Loaded once at
# boot (like PRICING_PATH); a team must still have the tier name itself
# in its allowed_models to request it — see config/tiers.yaml's own
# comments and app/resilience/fallback.py.
TIERS_CONFIG_PATH=config/tiers.yaml

# --- Phase 2: Redis + Admin API ---------------------------------------------
REDIS_URL=redis://localhost:6379/0

# Elevated secret for every /admin/* route (X-Gateway-Admin-Key header).
# Distinct from any team key. Generate one with e.g. `openssl rand -hex 32`.
GATEWAY_ADMIN_KEY=

# Resolves the TRD Appendix A "Redis failure mode" open decision for the
# RATE-LIMIT axis only (budget enforcement is always fail-closed, not a
# toggle — see app/ratelimit/budget.py). true = fall back to a local,
# non-distributed limiter and keep serving traffic; false = reject with
# 503 whenever Redis is unreachable.
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_KEY_TTL_SECONDS=7200

# Soft-warning threshold as a fraction of a team's budget cap (TRD: 80%).
BUDGET_WARN_FRACTION=0.8

# Batch-priority queueing (see app/ratelimit/priority_queue.py).
BATCH_QUEUE_MAX_WAIT_SECONDS=2.0
BATCH_QUEUE_POLL_INTERVAL_SECONDS=0.1
BATCH_QUEUE_MAX_LENGTH=200

# --- Phase 3: health checking (app/resilience/health.py) --------------------
# IMPORTANT: when true (the TRD-recommended default, confirmed at Phase 3
# sign-off), the background prober makes REAL HTTP calls to every
# provider-model pair reachable from TIERS_CONFIG_PATH's chains, on this
# interval — that costs API credits and needs live credentials in every
# environment that leaves this on, CI included. Set to false for local
# dev / CI unless you've pointed the provider *_BASE_URL vars at mocks.
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_SECONDS=30.0
HEALTH_CHECK_PROBE_TIMEOUT_SECONDS=10.0
# Rolling passive+active observation window (Document 05:
# health:{provider}:{model}, "rolling 60s window").
HEALTH_WINDOW_SECONDS=60
# TRD gives a worked example for "degraded" (>30% error rate); "down" and
# the latency figure are this gateway's own assumption, not a doc'd
# number — tune freely, see app/core/config.py's GatewaySettings docstring.
HEALTH_DEGRADED_ERROR_RATE=0.3
HEALTH_DOWN_ERROR_RATE=0.8
HEALTH_DEGRADED_LATENCY_P99_MS=5000.0

# --- Phase 3: circuit breaker (app/resilience/circuit_breaker.py) -----------
# TRD Appendix A's own v1 recommendation: a fixed failure count over a
# fixed-size rolling window (5-in-10 = 50% failure rate), not a
# time-windowed percentage — see the module docstring for why.
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_WINDOW_SIZE=10
CIRCUIT_BREAKER_COOLDOWN_SECONDS=60.0

# --- Phase 3: retry with backoff (app/resilience/retry.py) ------------------
# TRD: "retry the primary with exponential backoff (up to 3 retries)".
# Full-jitter formula: delay = random(0, min(max_delay, base * 2^(n-1))).
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.2
RETRY_MAX_DELAY_SECONDS=4.0

# --- Phase 4: observability (app/observability/tracing.py, metrics.py) -----
# Resource identity for every span this process emits.
OTEL_SERVICE_NAME=llm-gateway

# OTLP/HTTP traces endpoint. Left blank here (spans are still created --
# usable by anything that adds its own span processor, e.g. the test
# suite's InMemorySpanExporter -- just never exported anywhere) since
# this Phase 4 delivery doesn't stand up a local collector; that's
# Phase 5's docker-compose. Point it at one once you have it, e.g.:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=

# Deliberately left UNSET, not "gen_ai_latest_experimental" -- see
# app/observability/tracing.py's module docstring. Nothing in the
# dedicated semantic-conventions-genai repo is Stable as of this pass and
# there's no versioned schema yet to opt into; this codebase pins the
# pre-v1.42.0 gen_ai.* baseline directly in code instead. Revisit once
# that repo cuts a first tagged release.
OTEL_SEMCONV_STABILITY_OPT_IN=

# Compliance default per the TRD: OFF. Even when on, capture goes out as
# a gateway-owned span EVENT (not a gen_ai.*-namespaced one, and never a
# span ATTRIBUTE) -- see tracing.py's `maybe_capture_content`. Flip only
# for local debugging, never in an environment that isn't yours alone.
OTEL_CAPTURE_MESSAGE_CONTENT=false

# GET /metrics (Prometheus exposition). true by default; false 404s the
# endpoint instead of serving an always-empty body, so a misconfigured
# scrape target fails loudly rather than silently recording zero series.
METRICS_ENABLED=true

# Alert-rule threshold (deploy/prometheus/alerts.yml's
# GatewayLatencyP99AboveSLA) -- mirrors HEALTH_DEGRADED_LATENCY_P99_MS
# above (5000ms = 5.0s) per explicit Phase 4 sign-off ("keep Phase 3's
# assumed defaults"). Not read by the alert rule itself at evaluation
# time (Prometheus rules are static YAML) -- keep these in sync by hand
# if either is retuned.
ALERT_LATENCY_P99_SECONDS=5.0

# Slack incoming-webhook URL for Alertmanager routing
# (deploy/alertmanager/alertmanager.yml). That file reads it from a
# MOUNTED FILE (slack_api_url_file), not this env var directly --
# Alertmanager's own config doesn't support raw env-var interpolation.
# This setting exists for the gateway PROCESS itself, in case it ever
# needs to post directly rather than only through Alertmanager; unused
# by anything shipped in Phase 4. Leave blank for local dev.
SLACK_WEBHOOK_URL=
